# Vercel KV connection details.
#
# Local development works with NONE of these set — lib/store.js detects
# their absence and transparently falls back to an in-memory report list
# so `npm run dev` runs with zero cloud setup.
#
# When you connect a Vercel KV store to this project from the Vercel
# dashboard (Storage -> KV -> Connect Project), these are injected
# automatically for your deployments. Only copy this file to .env.local
# and fill it in if you want to test against real KV from your laptop.

KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=
