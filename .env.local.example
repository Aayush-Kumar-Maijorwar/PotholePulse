# Upstash Redis connection details (connected via the Vercel Marketplace —
# Vercel KV itself has been discontinued in favor of this).
#
# Local development works with NEITHER of these set — lib/store.js detects
# their absence and transparently falls back to an in-memory report list
# so `npm run dev` runs with zero cloud setup.
#
# When you connect an Upstash Redis store to this project from the Vercel
# dashboard (Storage -> Marketplace Database Providers -> Upstash ->
# Connect Project), these are injected automatically for your deployments.
# Only copy this file to .env.local and fill it in if you want to test
# against real Redis from your laptop.

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
